# ===== Parse Server ตั้งค่า =====
APP_ID=security-app
MASTER_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
JAVASCRIPT_KEY=REPLACE_WITH_RANDOM_KEY
REST_API_KEY=REPLACE_WITH_RANDOM_KEY
CLIENT_KEY=REPLACE_WITH_RANDOM_KEY
DOT_NET_KEY=REPLACE_WITH_RANDOM_KEY

# ===== MongoDB =====
DATABASE_URI=mongodb://security_user:security_pass@localhost:27017/securitydb?authSource=admin
MONGO_USERNAME=security_user
MONGO_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MONGO_DB=securitydb

# ===== API =====
SERVER_PORT=1337
HOST=0.0.0.0
MOUNT_PATH=/parse
PUBLIC_SERVER_URL=http://localhost:1337/parse

# IP ที่ใช้ masterKey ได้ (คั่นด้วย ,) — เว้นว่างไว้เพื่อใช้ค่า default ของ server.js
MASTER_KEY_IPS=127.0.0.1,::1,172.20.0.1

# Origin ที่อนุญาตให้เรียกข้ามโดเมน (คั่นด้วย ,)
ALLOWED_ORIGINS=http://localhost:3000

# ===== Authentication =====
# true = ต้องยืนยันอีเมลก่อน login ได้ ต้องตั้งค่า Mail ด้านล่างด้วย
VERIFY_USER_EMAILS=false
ACCOUNT_LOCKOUT_DURATION_MIN=5
ACCOUNT_LOCKOUT_THRESHOLD=5

# ===== Rate Limit =====
# จำนวน request สูงสุดต่อ IP ใน RATE_LIMIT_WINDOW_MIN นาที
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW_MIN=15

# ===== Upload =====
MAX_UPLOAD_SIZE=10mb

# ===== Port Scan =====
# เปิดการสแกนพร้อมกันได้กี่พอร์ตต่อครั้ง
SCAN_CONCURRENCY=32
# เพิ่มเป้าหมายที่อนุญาตให้สแกนได้ (คั่นด้วย ,) ค่าเริ่มต้นคือ loopback เท่านั้น
SCAN_ALLOWED_HOSTS=
# true = อนุญาตให้สแกน private range (10.x, 192.168.x, 172.16-31.x)
SCAN_ALLOW_PRIVATE=false

# ===== Incident =====
# จำนวน note สูงสุดต่อ incident และความยาวสูงสุดของแต่ละ note
INCIDENT_MAX_NOTES=100
INCIDENT_MAX_NOTE_LENGTH=2000

# ===== Report =====
# จำนวน alert สูงสุดที่นับในรายงานสรุป
REPORT_ALERT_LIMIT=1000

# ===== Dashboard =====
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DASHBOARD_PATH=/dashboard
# true เฉพาะตอนทดสอบบน localhost — ห้ามเปิดใน production
ALLOW_INSECURE_HTTP=false

# ===== Mail (สำหรับยืนยันอีเมลและแจ้งเตือน) =====
# ต้องติดตั้ง parse-server-simple-mailgun-adapter ก่อนใช้งานจริง
# EMAIL_FROM_ADDRESS=security@example.com
# EMAIL_FROM_NAME=Security Team
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_API_KEY=REPLACE_WITH_MAILGUN_API_KEY

# ===== Logging =====
LOG_LEVEL=info
LOG_VERBOSE=false