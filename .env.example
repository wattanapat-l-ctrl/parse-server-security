# ===== Parse Server ตั้งค่า =====
APP_ID=security-app
MASTER_KEY=REPLACE_WITH_STRONG_RANDOM_KEY
JAVASCRIPT_KEY=REPLACE_WITH_RANDOM_KEY
REST_API_KEY=REPLACE_WITH_RANDOM_KEY
CLIENT_KEY=REPLACE_WITH_RANDOM_KEY
DOT_NET_KEY=REPLACE_WITH_RANDOM_KEY

# ===== MongoDB =====
DATABASE_URI=mongodb://security_user:security_pass@localhost:27017/securitydb?authSource=admin
MONGO_USERNAME=security_user
MONGO_PASSWORD=security_pass
MONGO_DB=securitydb

# ===== API =====
SERVER_PORT=1337
PUBLIC_SERVER_URL=http://localhost:1337/parse
MOUNT_PATH=/parse
# จำกัด masterKey ให้ใช้ได้เฉพาะ IP เหล่านี้ (คั่นด้วย ,)
# ค่า 127.0.0.1 และ ::1 คือ localhost ส่วน 172.20.0.1 คือ gateway ของ Docker network
# ที่ docker-compose.yml ตรึงไว้ (subnet 172.20.0.0/24) ต้องตรงกับค่า subnet นั้นเสมอ
MASTER_KEY_IPS=127.0.0.1,::1,172.20.0.1

# ===== Dashboard =====
DASHBOARD_PORT=4040
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DASHBOARD_HOST=localhost

# ===== Mail (สำหรับ alert) =====
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
# MAILGUN_DOMAIN=
# MAILGUN_API_KEY=

# ===== Logging =====
LOG_VERBOSE=false
LOG_LEVEL=info